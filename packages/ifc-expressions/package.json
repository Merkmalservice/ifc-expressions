{
  "name": "ifc-expressions",
  "version": "3.0.0",
  "description": "Parsing and evaluation of IFC expressions",
  "main": "dist/cjs/IfcExpression.js",
  "module": "dist/mjs/IfcExpression.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/mjs/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Merkmalservice/ifc-expressions.git",
    "directory": "packages/ifc-expressions"
  },
  "homepage": "https://github.com/Merkmalservice/ifc-expressions#readme",
  "bugs": {
    "url": "https://github.com/Merkmalservice/ifc-expressions/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "./dist/**/*",
    "./dist/*"
  ],
  "engines": {
    "node": ">=14.16"
  },
  "scripts": {
    "build-complete": "pnpm run format-apply && pnpm run build && pnpm run test",
    "build": "pnpm run clean && pnpm run make-parser && pnpm run transpile",
    "clean": "gulp clean",
    "make-parser": "antlr-ng --generate-visitor --warnings-are-errors -Dlanguage=TypeScript --exact-output-dir -o src/gen/parser src/grammar/IfcExpression.g4",
    "transpile": "gulp build",
    "pretest": "pnpm run make-parser",
    "test": "jest --coverage",
    "typecheck": "pnpm run make-parser && tsc --noEmit -p tsconfig.json",
    "format-apply": "prettier --write .",
    "lint": "eslint .",
    "format-check": "prettier --check .",
    "check": "pnpm run format-check && pnpm run lint",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "IFC",
    "Expressions",
    "BIM",
    "Formula"
  ],
  "dependencies": {
    "antlr4-c3": "^3.4.4",
    "antlr4ng": "^3.0.16",
    "decimal.js": "^10.4.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "antlr-ng": "^1.0.10",
    "del": "^9.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "gulp": "^5.0.1",
    "gulp-replace": "^1.1.4",
    "gulp-typescript": "^6.0.0-alpha.1",
    "gulp-uglify": "^3.0.2",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "ts-jest": "^29.4.15",
    "typescript": "^7.0.2"
  }
}
