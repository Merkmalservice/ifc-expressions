{
  "name": "ifc-expressions-units",
  "version": "0.1.1",
  "description": "Provider-neutral unit and measure support for ifc-expressions",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Merkmalservice/ifc-expressions.git",
    "directory": "packages/ifc-expressions-units"
  },
  "homepage": "https://github.com/Merkmalservice/ifc-expressions#readme",
  "bugs": {
    "url": "https://github.com/Merkmalservice/ifc-expressions/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "ifc-expressions": "^4.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "pnpm --filter ifc-expressions build && pnpm run build",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pack:check": "npm pack --dry-run"
  },
  "devDependencies": {
    "ifc-expressions": "workspace:*",
    "typescript": "7.0.2"
  }
}
