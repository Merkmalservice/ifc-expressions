{
  "name": "@ifc-expressions/units-qudtlib",
  "version": "0.1.1",
  "description": "QUDT provider for @ifc-expressions/units",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Merkmalservice/ifc-expressions.git",
    "directory": "packages/units-qudtlib"
  },
  "homepage": "https://github.com/Merkmalservice/ifc-expressions#readme",
  "bugs": {
    "url": "https://github.com/Merkmalservice/ifc-expressions/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@ifc-expressions/core": "^4.0.0",
    "@ifc-expressions/units": "^0.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "pnpm --filter @ifc-expressions/core build && pnpm --filter @ifc-expressions/units build && pnpm run build",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pack:check": "npm pack --dry-run"
  },
  "devDependencies": {
    "@ifc-expressions/core": "workspace:*",
    "@ifc-expressions/units": "workspace:*",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@qudtlib/allunits": "7.2.0"
  }
}
